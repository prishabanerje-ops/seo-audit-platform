# ─── Core ──────────────────────────────────────────────────────────────────────
NODE_ENV=development              # "development" | "production"
PORT=3001                         # Backend HTTP port
FRONTEND_URL=http://localhost:5173 # Frontend origin — used for CORS + cookie SameSite

# ─── Security ──────────────────────────────────────────────────────────────────
JWT_SECRET=                       # REQUIRED. Min 64 random chars. Generate: openssl rand -hex 64
ENCRYPTION_KEY=                   # REQUIRED in production. 32-byte hex key for AES-256.
                                  # Generate: openssl rand -hex 32

# ─── Screaming Frog ────────────────────────────────────────────────────────────
SF_BINARY_PATH=                   # Absolute path to SF CLI binary or wrapper script
                                  # Example: /usr/local/bin/screaming-frog
                                  # Leave empty to boot in import-only mode
SF_LICENSE_KEY=                   # Optional. SF licence key for unlimited URL crawls.
                                  # Leave empty for free tier (500 URL limit).

# ─── Google OAuth (GSC + GA4) ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=                 # Required for GSC and GA4 OAuth
GOOGLE_CLIENT_SECRET=             # Required for GSC and GA4 OAuth
GOOGLE_REDIRECT_URI=              # Must match Google Console exactly
                                  # Format: http://localhost:3001/api/gsc/callback

# ─── Google Service Account (Sheets export) ────────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=./google-service-account.json
                                  # Path to GCP service account JSON file
                                  # Required only for Google Sheets export

# ─── AI ────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=                # Required for AI recommendations
                                  # Can also be set via Settings UI (stored encrypted in DB)

# ─── PageSpeed Insights ────────────────────────────────────────────────────────
PSI_API_KEY=                      # Optional. Google PageSpeed Insights API key.
                                  # Leave empty to use unauthenticated (rate-limited) requests.

# ─── Notifications ─────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=                # Optional. Slack incoming webhook URL
SMTP_HOST=                        # Optional. SMTP server hostname
SMTP_PORT=587                     # Optional. SMTP port (587 = STARTTLS, 465 = SSL)
SMTP_USER=                        # Optional. SMTP username
SMTP_PASS=                        # Optional. SMTP password
SMTP_FROM=noreply@yourplatform.com # From address for all outgoing emails
