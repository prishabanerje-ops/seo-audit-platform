{
  "name": "seo-audit-platform",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted technical SEO audit platform",
  "scripts": {
    "dev": "concurrently --names \"backend,frontend\" --prefix-colors \"cyan,magenta\" \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "build": "npm run build --prefix frontend",
    "start": "npm run start --prefix backend",
    "serve": "npm run build && npm run start",
    "setup": "bash setup.sh",
    "migrate": "node backend/db/sqlite.js",
    "seed": "node scripts/seed-checks.js",
    "test": "npm run test --prefix backend",
    "test:auth": "npm run test:auth --prefix backend"
  },
  "devDependencies": {
    "better-sqlite3": "^12.9.0",
    "concurrently": "^9.1.0",
    "dotenv": "^17.4.2"
  }
}
